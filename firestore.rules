rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcı fonksiyonlar ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    // Çağıranın kendi profilini okur (tekil get() — liste-sorgu ispat
    // kısıtına takılmaz; profil yoksa fonksiyon hata verir, çağıran ifade
    // false'a düşer).
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userFirma() { return callerProfile().firma; }
    function userRole()  { return callerProfile().rol; }

    function isSuperAdmin() { return isSignedIn() && userRole() == 'superadmin'; }
    function isYonetici()   { return isSignedIn() && userRole() == 'yonetici'; }

    // docFirma: kontrol edilen dokümanın 'firma' alanı
    function sameFirma(docFirma) {
      return isSignedIn() && docFirma is string && docFirma == userFirma();
    }

    function isNonEmptyString(v) { return v is string && v.size() > 0; }

    // ── firmalar/{firmaId} ──────────────────────────────────────────────────
    // Artık login-öncesi bir "Firma Seçimi" ekranı yok (hesap zaten hangi
    // firmaya kayıtlıysa giriş sonrası o açılıyor) — bu yüzden okuma da
    // giriş yapmış kullanıcılarla sınırlı, firma listesi herkese açık
    // listelenebilir olmasın diye. Yazma sadece süper yönetici (Firma
    // Yönetimi paneli).
    match /firmalar/{firmaId} {
      allow read: if isSignedIn();

      allow create: if isSuperAdmin()
        && isNonEmptyString(request.resource.data.ad)
        && request.resource.data.sablon in ['standart', 'wms31', 'wms_redbull']
        && request.resource.data.aktif is bool;

      // Süper yönetici ad/unvan/sablon/aktif dahil her alanı değiştirebilir.
      // Yönetici SADECE kendi firmasının masterdata sayaç alanlarını
      // (skuMasterdataSayisi/lokasyonSayisi) güncelleyebilir — ad/unvan/sablon/
      // aktif'e dokunamaz (updateFirmaSkuMasterdata/uploadFirmaLokasyonlar'ın
      // yazdığı tek şey bu iki sayaç).
      allow update: if (
        isSuperAdmin()
        && isNonEmptyString(request.resource.data.ad)
        && request.resource.data.sablon in ['standart', 'wms31', 'wms_redbull']
        && request.resource.data.aktif is bool
      ) || (
        isYonetici()
        && userFirma() == firmaId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['skuMasterdataSayisi', 'lokasyonSayisi'])
      );

      allow delete: if isSuperAdmin();
    }

    // ── firmalar/{firmaId}/skuMasterdataChunks, lokasyonChunks ──────────────
    // Manuel giriş doğrulaması için firma bazlı referans listeleri (Kod/Ad/
    // Birim ve lokasyon kodları). Süper yönetici (Firma Yönetimi) veya
    // firmanın kendi yöneticisi (Ayarlar → Masterdata) yazabilir; kontrolcü/
    // sayımcı sadece okur (ComboBox autofill/doğrulama için).
    match /firmalar/{firmaId}/skuMasterdataChunks/{chunkId} {
      allow read:  if isSuperAdmin() || userFirma() == firmaId;
      allow write: if isSuperAdmin() || (isYonetici() && userFirma() == firmaId);
    }
    match /firmalar/{firmaId}/lokasyonChunks/{chunkId} {
      allow read:  if isSuperAdmin() || userFirma() == firmaId;
      allow write: if isSuperAdmin() || (isYonetici() && userFirma() == firmaId);
    }

    // ── users/{uid} ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isYonetici() && sameFirma(resource.data.firma))
      );

      // Yeni kullanıcı oluşturma: SADECE bir admin tarafından.
      //  - süper yönetici: her şeyi yazabilir
      //  - yönetici: SADECE kendi firmasına, SADECE yonetici/kontrolcu/sayimci rolüyle
      // Bilinçli olarak "kendi kendine bootstrap" (herhangi bir auth hesabının ilk
      // girişte kendi profilini yazması) YOKTUR: Firebase Email/Şifre sağlayıcısı
      // proje genelinde tek bir anahtar olduğundan (createUserAccount'ın kullandığı
      // ikincil auth örneği de dahil), bu sağlayıcı açıkken herkes public client
      // SDK ile doğrudan yeni bir hesap oluşturabilir. Self-bootstrap izni olsaydı
      // (o zamanlar 'firmalar' herkese açık okunabilirken), böyle biri bir firma
      // id'si alıp kendini o firmanın 'sayimci'sı olarak kaydedip firmanın tüm
      // sessions/results verisini okuyabilirdi. Bu yüzden her hesap MUTLAKA bir
      // yönetici/süper yönetici tarafından (Ayarlar → Kullanıcılar veya migrasyon
      // script'i ile) oluşturulmalı; Firebase Console'dan doğrudan Auth kullanıcısı
      // açmak artık desteklenmiyor (profilsiz kalır, giriş yapamaz).
      allow create: if isSuperAdmin()
        || (
          isYonetici()
          && sameFirma(request.resource.data.firma)
          && request.resource.data.rol in ['yonetici', 'kontrolcu', 'sayimci']
        );

      // Güncelleme: 'firma' alanı SABİT kalmalı (firma değiştirerek başka
      // kiracıya geçmek engellenir); hiçbir yönetici kimseyi 'superadmin'
      // yapamaz veya bir superadmin'i düzenleyemez. Hiçbir admin KENDİ
      // dokümanını bu yoldan değiştiremez/silemez (kazara kendi rolünü
      // düşürüp/kendini silip erişimini kaybetmesini önler — client zaten
      // bunu Ayarlar ekranında engelliyordu, kural seviyesinde de kapatıldı).
      allow update: if request.auth.uid != uid && (
        isSuperAdmin()
        || (
          isYonetici()
          && sameFirma(resource.data.firma)
          && request.resource.data.firma == resource.data.firma
          && resource.data.rol != 'superadmin'
          && request.resource.data.rol in ['yonetici', 'kontrolcu', 'sayimci']
        )
      );

      // Kullanıcı kendi profilini düzenleyebilir (Ayarlar → Profil /
      // Sayımcı Ekranı → Profil) — SADECE displayName alanı. rol/firma gibi
      // hassas alanlara kendi kendine dokunamaz; yukarıdaki "kendi dokümanını
      // değiştiremez" kısıtlaması bilinçli olarak burada ayrı/dar bir izinle
      // gevşetiliyor (self-lockout'un koruduğu asıl risk rol/firma yükseltmesi).
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isNonEmptyString(request.resource.data.displayName);

      allow delete: if request.auth.uid != uid && (
        isSuperAdmin()
        || (isYonetici() && sameFirma(resource.data.firma) && resource.data.rol != 'superadmin')
      );
    }

    // ── sessions/{sessionId} ─────────────────────────────────────────────
    // ── sayimNoSayac/{KOD} ── firma kodu bazında kesintisiz sayım no sayacı
    // (bkz. utils/sayimNo.js, useStore.sayimNoAta). Yalnız +1 artabilir,
    // silinemez — böylece bir numara iki kez üretilemez. Belge kimliği firma
    // kodunu taşıdığı için firma alanı yok; oturum yazabilen roller erişir.
    match /sayimNoSayac/{sayacId} {
      allow read: if isSuperAdmin() || isYonetici();
      allow create: if (isSuperAdmin() || isYonetici())
        && sayacId.matches('^[A-Z0-9]{2,5}$')
        && request.resource.data.son == 1;
      allow update: if (isSuperAdmin() || isYonetici())
        && request.resource.data.son == resource.data.son + 1;
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isSuperAdmin() || sameFirma(resource.data.firma);

      allow create: if isSuperAdmin()
        || (isYonetici() && sameFirma(request.resource.data.firma));

      // 'firma' alanı bir kez damgalanır, sonradan değiştirilemez.
      // Oturum 'Tamamlandı' (mutabakat onaylanmış) ise KİLİTLİ — tek istisna
      // sayimNotu alanı (onay sonrası da not eklenebilsin diye). approveSession
      // durum'u 'Mutabakat Bekliyor' → 'Tamamlandı' yaparken resource.data.durum
      // (eski değer) henüz 'Tamamlandı' olmadığından bu geçiş engellenmiyor —
      // engellenen, ZATEN Tamamlandı olan bir oturuma sonradan yapılacak yazmalar.
      // Sayımcı için DAR bir istisna (2026-08-11): sayım ekranındaki "Manuel
      // Fazla Stok" modalı, sistemde bulunmayan kalemleri session dokümanının
      // manualRows/korManualRows/koridorManualRows dizisine yazar. Bu izin
      // YOKKEN sayımcının eklediği kalem yerel state'te görünüyor ama Firestore
      // yazması permission-denied ile sessizce reddediliyordu → yöneticinin rapor
      // ekranında o satırlar hiç görünmüyordu. Sadece bu üç dizi + damga
      // alanları; type/durum/korCodes/koridorlar/firma gibi alanlara dokunamaz.
      // (Alan içi "sadece ekleme yapıldı" ispatı rules dilinde mümkün değil;
      // sayımcı zaten results alt koleksiyonuna serbestçe yazabildiği için
      // risk profili aynı seviyede kalıyor.)
      allow update: if (
        isSuperAdmin()
        || (
          isYonetici()
          && sameFirma(resource.data.firma)
          && request.resource.data.firma == resource.data.firma
        )
        || (
          isSignedIn()
          && sameFirma(resource.data.firma)
          && userRole() == 'sayimci'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['manualRows', 'korManualRows', 'koridorManualRows', 'updatedAt', 'updatedBy'])
        )
      ) && (
        resource.data.durum != 'Tamamlandı'
        // sayimNo: numara özelliğinden önce kapanmış oturumlara geriye dönük
        // numara verilebilsin diye (aşağıdaki kural bir kez yazılmasını garanti eder).
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sayimNotu', 'sayimNo', 'updatedBy', 'updatedAt'])
      ) && (
        // Sayım numarası bir kez verilir, sonra kimse (süper yönetici dahil)
        // değiştiremez/silemez — evraklardaki numara ile kayıt hep eşleşsin.
        !('sayimNo' in resource.data)
        || request.resource.data.get('sayimNo', null) == resource.data.sayimNo
      );

      allow delete: if isSuperAdmin() || (isYonetici() && sameFirma(resource.data.firma));

      // ── results/{rowId} ── canlı dinleyici (onSnapshot), filtresiz sorgu.
      // Kasıtlı olarak resource.data.firma DEĞİL, sabit ebeveyn get()'i
      // kullanılır — mevcut filtresiz sorgu bozulmaz, geriye dönük hiçbir
      // "results" dokümanına firma alanı eklemek GEREKMEZ.
      match /results/{rowId} {
        allow read: if isSuperAdmin()
          || sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma);

        // Yazma: yönetici (tüm oturumlar) veya sayımcı (sayım ekranından
        // miktar girer) — kontrolcü SALT-OKUNURDUR, hiçbir sayım sonucunu
        // değiştiremez (uygulamanın kendi rol tasarımı: kontrolcü sadece
        // analiz/rapor görür, "Onayla" bile client'ta gizlenmiştir).
        // Not: Bir sayımcının SADECE kendisine atanan satırlara yazabildiğini
        // (gorev bazlı) burada tam olarak ispatlamak mümkün değil — rules
        // dilinde rowId'den hangi sayimciGorevler dokümanına ait olduğunu
        // sorgu yapmadan bulamıyoruz (get() sadece sabit path alır). Bu,
        // gorev dokümanlarına deterministik bir id şeması (ör.
        // `${sessionId}_${sayimciUid}`) eklenerek ileride sıkılaştırılabilir.
        // Oturum 'Tamamlandı' ise sayım sonucu artık HERKES için (süper
        // yönetici dahil) salt-okunur — "tüm inputlar kilitlensin" isteği.
        // approveSession() bu satırları TAMAMLANDI'ya geçmeden HEMEN ÖNCE
        // (durum hâlâ 'Mutabakat Bekliyor'ken) yazdığı için onay akışı bundan
        // etkilenmiyor.
        allow write: if get(/databases/$(database)/documents/sessions/$(sessionId)).data.durum != 'Tamamlandı'
          && (
            isSuperAdmin()
            || (
              isSignedIn()
              && sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma)
              && userRole() in ['yonetici', 'sayimci']
            )
          );
      }

      // ── sayimLog/{logId} ── sayım işlem logu (denetim izi). SALT-EKLEME:
      // results'a yazabilen herkes kendi adına (uid == auth.uid) kayıt
      // ekleyebilir; hiçbir rol (süper yönetici dahil) kaydı düzenleyemez veya
      // silemez — sayımcının "sayıp saymadığını" gösteren iz değiştirilemesin.
      // Okuma yalnız yönetici/kontrolcü/süper yönetici; sayımcı göremez.
      match /sayimLog/{logId} {
        allow read: if isSuperAdmin()
          || (
            isSignedIn()
            && sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma)
            && userRole() in ['yonetici', 'kontrolcu']
          );

        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && (
            isSuperAdmin()
            || (
              sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma)
              && userRole() in ['yonetici', 'sayimci']
            )
          );

        allow update, delete: if false;
      }

      // ── rowChunks/{chunkId} ── sadece yönetici yazar, aynı get() stratejisi.
      match /rowChunks/{chunkId} {
        allow read: if isSuperAdmin()
          || sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma);

        allow write: if isSuperAdmin()
          || (isYonetici()
              && sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma));
      }

      // ── sayimciGorevler/{gorevId} ── nested erişim: burada da get()
      // stratejisi kullanılır (loadSessionGorevler'ın filtresiz sorgusu
      // değişmeden çalışsın diye). Doküman yine de kendi 'firma' alanını
      // taşır (aşağıdaki collectionGroup kuralı için zorunlu).
      match /sayimciGorevler/{gorevId} {
        allow read: if isSuperAdmin()
          || sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma);

        allow create: if isSuperAdmin()
          || (
            isYonetici()
            && sameFirma(get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma)
            && request.resource.data.firma
                 == get(/databases/$(database)/documents/sessions/$(sessionId)).data.firma
          );

        allow update: if isSuperAdmin()
          || (
            isYonetici()
            && sameFirma(resource.data.firma)
            && request.resource.data.firma == resource.data.firma
          )
          || (
            // sayımcı: sadece KENDİ görevinin 'durum' alanı + bitiş damgası
            // ('tamamlanmaZamani', görevin son kalemi de sayıldığında
            // updateGorevDurum tarafından bir kez yazılır). Damga yazılıyorsa
            // serverTimestamp() olmak ZORUNDA — sayımcı geçmiş/gelecek bir
            // bitiş saati uyduramasın diye request.time ile karşılaştırılıyor.
            isSignedIn()
            && request.auth.uid == resource.data.sayimciUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'tamamlanmaZamani'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tamamlanmaZamani'])
              || request.resource.data.tamamlanmaZamani == request.time
            )
          );

        // Süper yönetici + yönetici (kendi firması) her görevi silebilir.
        // Sayımcı manuel silemez; sadece kendi öksüz kalmış (ebeveyn oturumu
        // silinmiş) görevini otomatik temizleyebilir (bkz. loadMyGorevler).
        allow delete: if isSuperAdmin()
          || (isYonetici() && sameFirma(resource.data.firma))
          || (
            isSignedIn()
            && request.auth.uid == resource.data.sayimciUid
            && !exists(/databases/$(database)/documents/sessions/$(sessionId))
          );
      }
    }

    // ── collectionGroup sorgusu: loadMyGorevler burayı kullanır ──────────
    // Burada get() kullanılamaz: eşleşen her doküman farklı bir ebeveyn
    // session'a ait olabilir (path sabit değil) — bu yüzden dokümanın
    // kendi 'firma' alanı zorunlu, istemci sorgusuna da
    // where('firma','==', kendiFirman) eklenmesi gerekir (aksi halde
    // Firestore "ispatlanamaz" diyerek sorgunun tamamını reddeder).
    match /{path=**}/sayimciGorevler/{gorevId} {
      allow read: if isSuperAdmin() || sameFirma(resource.data.firma);
    }
  }
}
